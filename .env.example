# ---- runtime ----
APP_NAME=AI Film Studio
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# Where config/*.yaml lives (defaults to <repo>/config)
# APP_CONFIG_DIR=./config
# Where sqlite db, uploads and generated media live
# APP_DATA_DIR=./data
# DATABASE_URL=postgresql+psycopg://studio:studio@localhost:5432/studio
# APP_INLINE_TASKS=0
# APP_MAX_WORKERS=4
# APP_ALLOW_DEV_AUTH=1
# APP_DEMO_USER_ID=user_demo

# ---- media tooling ----
# FFMPEG_BIN=ffmpeg
# FFPROBE_BIN=ffprobe

# ---- object storage (local filesystem is the default backend) ----
# STORAGE_BACKEND=local
# STORAGE_ROOT=./data/storage
# STORAGE_BACKEND=s3
# S3_BUCKET=ai-film-studio
# S3_ENDPOINT_URL=http://localhost:9000
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# ---- model provider credentials (NEVER put keys in YAML) ----
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# VIDEO_A_API_KEY=
# VIDEO_A_BASE_URL=
# VIDEO_B_API_KEY=
# WAN_WORKER_URL=http://localhost:8188

# Force every agent onto one provider without editing YAML (dev/staging only)
# AGENT_MODEL_PROVIDER=mock
# AGENT_MODEL_ID=
