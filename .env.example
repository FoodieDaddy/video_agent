# ---- runtime ----
APP_NAME=AI Film Studio
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# Where config/*.yaml lives (defaults to <repo>/config)
# APP_CONFIG_DIR=./config
# Where sqlite db, uploads and generated media live
# APP_DATA_DIR=./data
# DATABASE_URL=postgresql+psycopg://studio:studio@localhost:5432/studio
# APP_INLINE_TASKS=0
# APP_MAX_WORKERS=4
# APP_ALLOW_DEV_AUTH=1
# APP_DEMO_USER_ID=user_demo

# ---- media tooling ----
# FFMPEG_BIN=ffmpeg
# FFPROBE_BIN=ffprobe

# ---- object storage (local filesystem is the default backend) ----
# STORAGE_BACKEND=local
# STORAGE_ROOT=./data/storage
# STORAGE_BACKEND=s3
# S3_BUCKET=ai-film-studio
# S3_ENDPOINT_URL=http://localhost:9000
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# ---- model provider credentials (never commit real keys) ----
# 默认文字供应商 fast_gateway；地址、模型和密钥在 .env 中统一管理。
# 将此文件复制为 .env 后填入实际值，勿提交 .env。
FAST_GATEWAY_API_KEY=
FAST_GATEWAY_BASE_URL=https://fast.sbbbbbbbbb.xyz/v1
FAST_GATEWAY_MODEL=gpt-6.1-terra

# Provider files hold `api_key: env:OPENAI_API_KEY` (or a literal key) and
# `url: https://...`; this file only supplies the variables those reference.
# To take the URL from the environment too, write `url: env:OPENAI_BASE_URL`.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_COMPAT_API_KEY=
# OPENAI_COMPAT_BASE_URL=
# Local vLLM (config/providers/llm.yaml -> qwen)
# QWEN_API_KEY=
# VLLM_BASE_URL=http://127.0.0.1:8000/v1
# Local MiniMax-H3 style video service (config/providers/video.yaml -> minimax)
# MINIMAX_API_KEY=
# LOCAL_VISION_API_KEY=
# LOCAL_VISION_BASE_URL=
# LOCAL_IMAGE_API_KEY=
# LOCAL_IMAGE_BASE_URL=
# LOCAL_TTS_API_KEY=
# LOCAL_TTS_BASE_URL=
# LOCAL_VIDEO_BASE_URL=
# VIDEO_API_KEY=
# VIDEO_BASE_URL=

# Force every agent onto one provider without editing YAML (dev/staging only)
# AGENT_MODEL_PROVIDER=mock
# AGENT_MODEL_ID=
